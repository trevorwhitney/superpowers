#!/usr/bin/env bash
# Generate a review package: commit list (if any), stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call.
#
# This fork's SDD keeps the implementer's work UNCOMMITTED until a human
# approves it, so --working-tree packages the diff against HEAD. A committed
# BASE..HEAD range is still supported for the final whole-branch review.
# Using the recorded per-task BASE (not HEAD~1) keeps multi-commit ranges
# intact.
#
# Usage:
#   review-package --working-tree PLAN_FILE [OUTFILE]  # uncommitted per-task review
#   review-package PLAN_FILE BASE HEAD [OUTFILE]       # committed range (final review)
# Default OUTFILE, under <repo-root>/.superpowers/sdd/<plan-basename>/:
#   working-tree: review-worktree-<head7>.diff
#   range:        review-<base7>..<head7>.diff
# (named per range, so a re-review after fixes gets a distinct fresh file).
set -euo pipefail

workspace() { "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$1"; }

if [ "${1:-}" = "--working-tree" ]; then
  if [ $# -lt 2 ] || [ $# -gt 3 ]; then
    echo "usage: review-package --working-tree PLAN_FILE [OUTFILE]" >&2
    exit 2
  fi

  plan=$2
  [ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

  head7=$(git rev-parse --short HEAD)
  if [ $# -eq 3 ]; then
    out=$3
  else
    out="$(workspace "$plan")/review-worktree-${head7}.diff"
  fi

  {
    echo "# Review package: uncommitted working-tree changes (base ${head7})"
    echo
    echo "## Status"
    git status --short
    echo
    echo "## Files changed"
    git diff --stat HEAD
    echo
    echo "## Diff"
    git diff -U10 HEAD
  } > "$out"

  changed=$(git diff --name-only HEAD | wc -l | tr -d ' ')
  echo "wrote ${out}: ${changed} file(s) changed, $(wc -c < "$out" | tr -d ' ') bytes"
  exit 0
fi

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "usage: review-package --working-tree PLAN_FILE [OUTFILE]  |  review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  out="$(workspace "$plan")/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
