#!/usr/bin/env bash
# Generate a review package: commit list (if any), stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call.
#
# This fork's SDD keeps the implementer's work UNCOMMITTED until a human
# approves it, so the default mode packages the working-tree diff against
# HEAD. A committed BASE..HEAD range is still supported for the final
# whole-branch review. Using the recorded per-task BASE (not HEAD~1) keeps
# multi-commit ranges intact.
#
# Usage:
#   review-package --working-tree [OUTFILE]   # uncommitted per-task review
#   review-package BASE HEAD [OUTFILE]         # committed range (final review)
# Default OUTFILE:
#   working-tree: <repo-root>/.superpowers/sdd/review-worktree-<head7>.diff
#   range:        <repo-root>/.superpowers/sdd/review-<base7>..<head7>.diff
set -euo pipefail

workspace() { "$(cd "$(dirname "$0")" && pwd)/sdd-workspace"; }

if [ "${1:-}" = "--working-tree" ]; then
  if [ $# -gt 2 ]; then
    echo "usage: review-package --working-tree [OUTFILE]" >&2
    exit 2
  fi
  head7=$(git rev-parse --short HEAD)
  if [ $# -eq 2 ]; then
    out=$2
  else
    out="$(workspace)/review-worktree-${head7}.diff"
  fi

  {
    echo "# Review package: uncommitted working-tree changes (base ${head7})"
    echo
    echo "## Status"
    git status --short
    echo
    echo "## Files changed"
    git diff --stat HEAD
    echo
    echo "## Diff"
    git diff -U10 HEAD
  } > "$out"

  changed=$(git diff --name-only HEAD | wc -l | tr -d ' ')
  echo "wrote ${out}: ${changed} file(s) changed, $(wc -c < "$out" | tr -d ' ') bytes"
  exit 0
fi

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package --working-tree [OUTFILE]  |  review-package BASE HEAD [OUTFILE]" >&2
  exit 2
fi

base=$1
head=$2

git rev-parse --verify --quiet "$base" >/dev/null || { echo "bad BASE: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "bad HEAD: $head" >&2; exit 2; }

if [ $# -eq 3 ]; then
  out=$3
else
  out="$(workspace)/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Review package: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Files changed"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
